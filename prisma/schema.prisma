generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  domainType   DomainType @default(FREE)
  customDomain String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  products     Product[]
  users        User[]

  @@map("stores")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CREATOR)
  storeId      String
  createdAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("users")
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  title         String
  description   String
  priceInPaise  Int
  coverImageKey String?
  fileKey       String
  fileName      String
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  store         Store         @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, status])
  @@map("products")
}

model Order {
  id                String      @id @default(cuid())
  storeId           String
  buyerEmail        String
  buyerPhone        String?
  buyerName         String
  orderNumber       Int         @unique @default(autoincrement())
  amountInPaise     Int
  status            OrderStatus @default(PENDING)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  store             Store       @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([buyerEmail])
  @@map("orders")
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  productId            String
  titleSnapshot        String
  priceInPaiseSnapshot Int
  createdAt            DateTime        @default(now())
  downloadTokens       DownloadToken[]
  order                Order           @relation(fields: [orderId], references: [id])
  product              Product         @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model DownloadToken {
  id          String    @id @default(cuid())
  orderItemId String
  token       String    @unique
  expiresAt   DateTime
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@map("download_tokens")
}

enum DomainType {
  FREE
  SUBDOMAIN
  CUSTOM
}

enum UserRole {
  CREATOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}
