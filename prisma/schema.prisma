generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  domainType      DomainType      @default(FREE)
  customDomain    String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          Order[]
  products        Product[]
  users           User[]
  examCountdowns  ExamCountdown[]
  notices         Notice[]

  @@map("stores")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CREATOR)
  storeId      String
  createdAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("users")
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  title         String
  subjectCode   String?
  description   String
  priceInPaise  Int
  coverImageKey String?
  fileKey       String
  fileName      String
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  store         Store         @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, status])
  @@map("products")
}

model Order {
  id                String          @id @default(cuid())
  storeId           String
  buyerEmail        String
  buyerPhone        String?
  buyerName         String
  orderNumber       Int             @unique @default(autoincrement())
  amountInPaise     Int
  status            OrderStatus     @default(PENDING)
  razorpayOrderId   String          @unique
  razorpayPaymentId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]
  emailDeliveries   EmailDelivery[]
  store             Store           @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([buyerEmail])
  @@map("orders")
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  productId            String
  titleSnapshot        String
  priceInPaiseSnapshot Int
  createdAt            DateTime        @default(now())
  downloadTokens       DownloadToken[]
  order                Order           @relation(fields: [orderId], references: [id])
  product              Product         @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model DownloadToken {
  id          String    @id @default(cuid())
  orderItemId String
  token       String    @unique
  expiresAt   DateTime
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@map("download_tokens")
}

/// A full audit trail of every download-link email attempt for an order —
/// the original checkout send is issued directly by OrderService and never
/// recorded here (see markPaidByRazorpayOrderId); every row in this table
/// comes from an admin-initiated resend, which is why sentToEmail can
/// differ from Order.buyerEmail. That field is never modified by a
/// resend — it stays exactly as submitted at checkout, for search/exports/
/// identification.
model EmailDelivery {
  id          String          @id @default(cuid())
  orderId     String
  sentToEmail String
  sentAt      DateTime        @default(now())
  status      DeliveryStatus
  triggeredBy DeliveryTrigger
  order       Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("email_deliveries")
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum DeliveryTrigger {
  CHECKOUT
  ADMIN_RESEND
}

/// Homepage countdown carousel entries — all manually entered by the
/// creator via /dashboard/countdowns, never scraped or pulled from an
/// external exam-calendar API. isActive is a manual on/off switch
/// independent of targetDateTime; the storefront additionally hides any
/// row whose targetDateTime has already passed, so a creator forgetting
/// to deactivate an old one doesn't show a negative countdown.
model ExamCountdown {
  id             String   @id @default(cuid())
  storeId        String
  examName       String
  label          String
  targetDateTime DateTime
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("exam_countdowns")
}

/// Homepage notice board entries — manually entered by the creator via
/// /dashboard/notices. publishedDate is the date shown to visitors
/// (e.g. backdated to when an announcement was actually made elsewhere),
/// deliberately separate from createdAt (when the row was added here).
model Notice {
  id            String   @id @default(cuid())
  storeId       String
  title         String
  publishedDate DateTime
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("notices")
}

enum DomainType {
  FREE
  SUBDOMAIN
  CUSTOM
}

enum UserRole {
  CREATOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}
