generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  domainType      DomainType      @default(FREE)
  customDomain    String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          Order[]
  products        Product[]
  users           User[]
  examCountdowns  ExamCountdown[]
  notices         Notice[]
  quizzes         Quiz[]

  @@map("stores")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CREATOR)
  storeId      String
  createdAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("users")
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  title         String
  subjectCode   String?
  description   String
  priceInPaise  Int
  coverImageKey String?
  fileKey       String
  fileName      String
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  store         Store         @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, status])
  @@map("products")
}

model Order {
  id                String          @id @default(cuid())
  storeId           String
  buyerEmail        String
  buyerPhone        String?
  buyerName         String
  orderNumber       Int             @unique @default(autoincrement())
  amountInPaise     Int
  status            OrderStatus     @default(PENDING)
  razorpayOrderId   String          @unique
  razorpayPaymentId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]
  emailDeliveries   EmailDelivery[]
  store             Store           @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([buyerEmail])
  @@map("orders")
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  productId            String
  titleSnapshot        String
  priceInPaiseSnapshot Int
  createdAt            DateTime        @default(now())
  downloadTokens       DownloadToken[]
  order                Order           @relation(fields: [orderId], references: [id])
  product              Product         @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model DownloadToken {
  id          String    @id @default(cuid())
  orderItemId String
  token       String    @unique
  expiresAt   DateTime
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@map("download_tokens")
}

/// A full audit trail of every download-link email attempt for an order —
/// the original checkout send is issued directly by OrderService and never
/// recorded here (see markPaidByRazorpayOrderId); every row in this table
/// comes from an admin-initiated resend, which is why sentToEmail can
/// differ from Order.buyerEmail. That field is never modified by a
/// resend — it stays exactly as submitted at checkout, for search/exports/
/// identification.
model EmailDelivery {
  id          String          @id @default(cuid())
  orderId     String
  sentToEmail String
  sentAt      DateTime        @default(now())
  status      DeliveryStatus
  triggeredBy DeliveryTrigger
  order       Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("email_deliveries")
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum DeliveryTrigger {
  CHECKOUT
  ADMIN_RESEND
}

/// Homepage countdown carousel entries — all manually entered by the
/// creator via /dashboard/countdowns, never scraped or pulled from an
/// external exam-calendar API. isActive is a manual on/off switch
/// independent of targetDateTime; the storefront additionally hides any
/// row whose targetDateTime has already passed, so a creator forgetting
/// to deactivate an old one doesn't show a negative countdown.
model ExamCountdown {
  id             String   @id @default(cuid())
  storeId        String
  examName       String
  label          String
  targetDateTime DateTime
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("exam_countdowns")
}

/// Homepage notice board entries — manually entered by the creator via
/// /dashboard/notices. publishedDate is the date shown to visitors
/// (e.g. backdated to when an announcement was actually made elsewhere),
/// deliberately separate from createdAt (when the row was added here).
model Notice {
  id            String   @id @default(cuid())
  storeId       String
  title         String
  publishedDate DateTime
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("notices")
}

/// Free-to-enter, skill-based quiz — deliberately NOT a random draw
/// (see QuizEntry) to stay clear of India's lottery/gambling regulations,
/// which a chance-based giveaway would risk. Status is the sole gate on
/// whether the public page accepts entries; there is no automatic
/// time-based transition — startsAt/endsAt are informational display
/// fields only, opening and closing are always a manual creator action
/// (see QuizService.close), since there's no automatic winner-selection
/// moment to trigger off of.
model Quiz {
  id        String     @id @default(cuid())
  storeId   String
  title     String
  subject   String
  status    QuizStatus @default(DRAFT)
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
  entries   QuizEntry[]
  store     Store      @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, status])
  @@map("quizzes")
}

model Question {
  id           String           @id @default(cuid())
  quizId       String
  text         String
  displayOrder Int              @default(0)
  options      QuestionOption[]
  quiz         Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_question_options")
}

/// One row per completed attempt. score/totalTimeMs together ARE the
/// winner list — sort by score DESC then totalTimeMs ASC (see
/// QuizService.listEntriesForQuiz) — there is no separate "winner" flag
/// or random-draw step; ranking IS the result, which is what keeps this
/// a skill-based contest rather than a lottery. No per-question answer
/// records are kept (schema deliberately has no Question/Option
/// relation here) — only the aggregate outcome, so editing a quiz's
/// questions after entries exist never orphans anything.
model QuizEntry {
  id          String   @id @default(cuid())
  quizId      String
  name        String
  email       String
  phone       String
  score       Int
  totalTimeMs Int
  completedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, email])
  @@index([quizId])
  @@map("quiz_entries")
}

enum QuizStatus {
  DRAFT
  LIVE
  CLOSED
}

enum DomainType {
  FREE
  SUBDOMAIN
  CUSTOM
}

enum UserRole {
  CREATOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}
