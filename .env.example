# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frostearth?schema=public"

# Auth
SESSION_SECRET="replace-with-a-long-random-string"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# Storage
# Local disk for development. Use "r2" in production/serverless (Vercel etc)
# since local disk does not persist there.
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./storage"

# Cloudflare R2 (only needed when STORAGE_DRIVER="r2")
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend). Leave EMAIL_PROVIDER unset/"console" to just log emails
# to the console instead of sending real ones (useful for local dev).
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="FrostEarth <onboarding@resend.dev>"
