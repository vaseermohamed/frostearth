# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frostearth?schema=public"

# Auth
SESSION_SECRET="replace-with-a-long-random-string"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# Storage
# Local disk for development. Use "r2" in production/serverless (Vercel etc)
# since local disk does not persist there.
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./storage"

# Cloudflare R2 (only needed when STORAGE_DRIVER="r2")
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron (Vercel Cron Jobs send this as `Authorization: Bearer <CRON_SECRET>` —
# see app/api/cron/cleanup-watermarks/route.ts). Generate a random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
CRON_SECRET=""

# Email. EMAIL_PROVIDER is "resend", "brevo", or "console" (default) —
# "console" just logs emails instead of sending them, useful for local dev.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM="FrostEarth <onboarding@resend.dev>"
